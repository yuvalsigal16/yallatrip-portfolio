# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (or the legacy "anon" key). Safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The SECRET key (or the legacy "service_role" key). Server only, never NEXT_PUBLIC_.
# Used for one job: writing the shared places table after checking the place at Google.
SUPABASE_SECRET_KEY=

# --- Google Maps Platform ---
# SERVER key: Places API (New) + Routes API only. Stays on the server, never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
# BROWSER key: Maps JavaScript API only, restricted to your domains (HTTP referrers).
# Draws the map. It is visible in the browser by design.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID (Google Cloud -> Google Maps Platform -> Map management). Needed for the custom pins.
# For local testing you can use DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Site address (used in email links and Google sign-in) ---
# Locally leave empty (it falls back to http://localhost:3000). In production: https://your-domain
NEXT_PUBLIC_SITE_URL=

# --- AI trip planner (optional) ---
# Without a key, "split into days" uses the map-based algorithm only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Paid routes (FUTURE, keep off for now) ---
# false = every route is free: no prices, no checkout, no commissions or payouts anywhere in the app.
# Turn on only when YallaTrip opens to the public and a payment provider is set up.
NEXT_PUBLIC_ENABLE_PAID_ROUTES=false
# Used only when NEXT_PUBLIC_ENABLE_PAID_ROUTES=true.
# Stripe: Dashboard -> Developers -> API keys / Webhooks (endpoint: https://your-domain/api/payments/webhook, event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
